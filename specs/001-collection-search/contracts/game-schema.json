{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "Game",
	"description": "A game in the library with metadata for searching and filtering",
	"type": "object",
	"required": [
		"id",
		"title",
		"file_path",
		"system"
	],
	"properties": {
		"id": {
			"type": "string",
			"description": "Unique identifier (UUID or file path hash)"
		},
		"title": {
			"type": "string",
			"minLength": 1,
			"description": "Display name of the game"
		},
		"file_path": {
			"type": "string",
			"description": "Absolute path to ROM file"
		},
		"system": {
			"type": "string",
			"description": "Console/platform identifier (e.g., 'nes', 'snes', 'gba')"
		},
		"genre": {
			"type": "array",
			"items": {
				"type": "string"
			},
			"default": [
				"Unknown"
			],
			"description": "List of genre tags"
		},
		"year": {
			"type": [
				"integer",
				"null"
			],
			"minimum": 1970,
			"maximum": 2100,
			"description": "Release year"
		},
		"player_count": {
			"type": "integer",
			"minimum": 1,
			"maximum": 8,
			"default": 1,
			"description": "Maximum number of players"
		},
		"favorite": {
			"type": "boolean",
			"default": false,
			"description": "User-marked favorite flag"
		},
		"play_count": {
			"type": "integer",
			"minimum": 0,
			"default": 0,
			"description": "Number of times launched"
		},
		"last_played": {
			"type": [
				"integer",
				"null"
			],
			"description": "Unix timestamp of last launch"
		}
	}
}